{
  "expo": {
    "name": "Visitor-Log",
    "slug": "Visitor-Log",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/profile.jpg",
    "scheme": "visitorlog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/profile.jpg",
        "backgroundImage": "./src/assets/images/profile.jpg",
        "monochromeImage": "./src/assets/images/profile.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.piyush22.VisitorLog"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/profile.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/profile.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c92544a8-a6e4-477d-9930-04bf81ff5575"
      }
    }
  }
}
